# EmailJS Configuration
# IMPORTANT: Replace these with your REAL EmailJS credentials
# Get them from https://dashboard.emailjs.com/

# Your EmailJS Service ID (from Email Services section)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxxxxxxxxxxx

# Your EmailJS Template ID (from Email Templates section)
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxxxxxxxxx

# Your EmailJS Public Key (from Account > General)
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: After updating these values, restart your development server:
# npm run dev